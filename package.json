{
  "name": "plugin-workbench",
  "productName": "可插件化工作台",
  "version": "0.2.0",
  "description": "可导入的工作台：用工作区包把任意脚本/命令变成可点击的按钮面板",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "test:electron:moments": "electron test/electron-moments.js",
    "test:moments": "node --test test/moments-agent.test.js"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.local.workbench",
    "productName": "可插件化工作台",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "workspaces/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "asar": false,
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Plugin Workbench Team"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
